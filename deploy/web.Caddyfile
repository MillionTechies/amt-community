# Inside the amt-community-web container. The server's Caddy terminates HTTPS and
# forwards plain HTTP here.
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	# Uploaded images: the API's media volume, mounted read-only at /srv/media.
	handle /media/* {
		root * /srv
		file_server
	}

	# The single-page app: real files as they are, every other path gets index.html
	# so links like /events/<slug> load the app, which then routes them.
	handle {
		root * /srv/site
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
