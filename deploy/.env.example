# Copy to .env on the server (never commit it) and fill in. docker-compose.yml reads it,
# and the API and worker get every value here as environment variables.

# The Docker network the server's Caddy container is on (the identity server uses the same).
# Find it with: docker inspect <caddy container> --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
PROXY_NETWORK=g8-yatch_g8net

# PostgreSQL password. Generate one: openssl rand -base64 32
DB_PASSWORD=

# Django. Generate the key: openssl rand -base64 48
DJANGO_SECRET_KEY=
# localhost: the container's own health check.
DJANGO_ALLOWED_HOSTS=api.community.amilliontechies.com,localhost
CORS_ALLOWED_ORIGINS=https://community.amilliontechies.com
CSRF_TRUSTED_ORIGINS=https://community.amilliontechies.com,https://api.community.amilliontechies.com

# Where people and links go. API_URL is also baked into the web app when it is built.
COMMUNITY_URL=https://community.amilliontechies.com
API_URL=https://api.community.amilliontechies.com

# The shared identity server. The secret: admin console, realm A Million Techies,
# Clients > community-backend > Credentials.
AMT_KEYCLOAK_URL=https://auth.amilliontechies.com
AMT_REALM=amilliontechies
AMT_CLIENT_ID=community-backend
AMT_CLIENT_SECRET=

# Email over SMTP (e.g. Zoho, as the identity server uses). Admins can also set these on
# Console > Configuration, which wins over the values here.
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=A Million Techies Community <community@amilliontechies.com>

# Connected accounts (optional): Google, Microsoft and Zoom OAuth apps. Usually set on
# Console > Configuration instead. Redirect URIs: <API_URL>/api/integrations/<provider>/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
# Encrypts stored tokens and secrets. Must be a Fernet key (URL-safe base64 of 32 bytes):
#   openssl rand -base64 32 | tr '+/' '-_'
# Never change it once set, or stored secrets can no longer be read.
INTEGRATIONS_ENCRYPTION_KEY=

# Backups (backup.sh): an rclone remote and path for the off-server copy,
# e.g. r2:amt-community-backups. Configure the remote with `rclone config`.
BACKUP_REMOTE=
