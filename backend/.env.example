# Copy to .env. These values match docker-compose.yml and scripts/keycloak-dev-setup.sh.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=community
DB_USER=community
DB_PASSWORD=community
DB_HOST=localhost
DB_PORT=5433

# amt-auth (Keycloak)
AMT_KEYCLOAK_URL=http://localhost:8080
AMT_REALM=amilliontechies
AMT_CLIENT_ID=amt-backend
AMT_CLIENT_SECRET=dev-backend-secret
AMT_WEBHOOK_SECRET=dev-webhook-secret

# Uploaded images: local disk unless a bucket is set (S3, DigitalOcean Spaces, Cloudflare R2).
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_CUSTOM_DOMAIN=
