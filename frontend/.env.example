# Copy to .env. These values match the local Keycloak realm and the Django API.
VITE_API_URL=http://localhost:8000
# Production: https://auth.amilliontechies.com, with client community-frontend.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=amilliontechies
VITE_KEYCLOAK_CLIENT_ID=amt-frontend
