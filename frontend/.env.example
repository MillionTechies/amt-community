# Copy to .env. Sign-in uses the shared identity server, locally as in production; it
# accepts http://localhost:5173, so keep the dev server on that port.
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=https://auth.amilliontechies.com
VITE_KEYCLOAK_REALM=amilliontechies
VITE_KEYCLOAK_CLIENT_ID=community-frontend
